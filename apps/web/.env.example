# =============================================================================
# apps/web — environment variables
# Copy to .env and fill in values for local development.
# =============================================================================

# URL reachable from the USER'S BROWSER — used by React islands (CSR).
# In production: your public API Gateway domain, e.g. https://api.yourdomain.com
# In local dev:  http://localhost:3000  (default if unset)
PUBLIC_API_URL=http://localhost:3000

# URL reachable from the SERVER only — used by Astro SSR pages and API routes.
# Stays inside the private network so SSR fetches never leave the host machine.
# In production: internal hostname, e.g. http://api-gateway:3000  or  http://10.0.0.5:3000
# In local dev:  http://localhost:3000  (same as PUBLIC_API_URL — that is fine)
INTERNAL_API_URL=http://localhost:3000

# Midtrans keys (needed for checkout page)
PUBLIC_MIDTRANS_CLIENT_KEY=
PUBLIC_MIDTRANS_IS_PRODUCTION=false
