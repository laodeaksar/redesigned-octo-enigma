---
import CartPage from "@/components/islands/CartPage";
import BaseLayout from "@/components/layout/BaseLayout.astro";
import { getCurrentUser } from "@/lib/auth";

const user = await getCurrentUser(Astro.cookies);
const isLoggedIn = !!user;
---

<BaseLayout title="Keranjang Belanja" description="Keranjang belanja kamu">
  <div class="container mx-auto px-4 py-10">
    <!-- Page header -->
    <div class="mb-8 flex items-center gap-3">
      <h1 class="text-2xl font-bold text-gray-900">Keranjang Belanja</h1>
    </div>

    <!-- Cart content — server-synced for logged-in users -->
    <CartPage client:load isLoggedIn={isLoggedIn} />
  </div>
</BaseLayout>
