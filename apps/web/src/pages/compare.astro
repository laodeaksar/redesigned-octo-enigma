---
import BaseLayout from "@/components/layout/BaseLayout.astro";
import ComparePage from "@/components/islands/ComparePage";
---

<BaseLayout
  title="Bandingkan Produk"
  description="Bandingkan produk pilihan kamu secara detail — harga, stok, spesifikasi, dan lebih banyak lagi."
>
  <div class="container mx-auto max-w-7xl px-4 py-8">

    <!-- Page header -->
    <div class="mb-8">
      <a
        href="/products"
        class="inline-flex items-center gap-1.5 text-sm text-gray-400 transition-colors hover:text-gray-700"
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
        Kembali ke Produk
      </a>
      <h1 class="mt-3 text-2xl font-bold text-gray-900 sm:text-3xl">Bandingkan Produk</h1>
      <p class="mt-1 text-sm text-gray-500">
        Pilih hingga {3} produk untuk dibandingkan secara detail.
      </p>
    </div>

    <!-- React island renders the full comparison table -->
    <ComparePage client:load />
  </div>
</BaseLayout>
