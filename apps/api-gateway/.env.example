# API Gateway — environment variables
# Copy to .env and fill in values for local development.

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=supersecret-dev-key-at-least-32-characters-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Database (audit logs) ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/myecommerce

# ── Redis (rate limiting) — optional in dev ───────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Upstream services ─────────────────────────────────────────────────────────
AUTH_SERVICE_URL=http://localhost:3001
PRODUCT_SERVICE_URL=http://localhost:3002
ORDER_SERVICE_URL=http://localhost:3003
PAYMENT_SERVICE_URL=http://localhost:8000

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins.
# Use * to allow any origin (development only — never use in production).
#
#   Single origin:    CORS_ORIGINS=https://store.example.com
#   Multiple origins: CORS_ORIGINS=https://store.example.com,https://admin.example.com
#   Dev wildcard:     CORS_ORIGINS=*
#
CORS_ORIGINS=http://localhost:5000

# ── Midtrans (optional — gateway-level webhook signature pre-verification) ────
# MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxx

# ── Security alerting (all optional) ─────────────────────────────────────────
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
# ALERT_EMAIL_TO=ops@example.com
# ALERT_THRESHOLD_LEVEL=HIGH
# ALERT_MONITOR_INTERVAL_SECONDS=60
# ALERT_COOLDOWN_MINUTES=15
# ALERT_ENV_NAME=production
