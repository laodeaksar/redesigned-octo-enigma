{
	"tabWidth": 2,
	"semi": true,
	"trailingComma": "es5",
	"printWidth": 80,
	"bracketSpacing": true,
	"arrowParens": "avoid",
	"endOfLine": "lf",
	"importOrder": [
		"^(react/(.*)$)|^(react$)",
		"^(astro/(.*)$)|^(astro$)",
    "<TYPES>^(node:)",
    "<TYPES>",
    "<TYPES>^[.]",
		"<THIRD_PARTY_MODULES>",
		"",
		"^@repo/(.*)$",
		"",
		"^types$",
		"^@/types/(.*)$",
		"^@/config/(.*)$",
		"^@/lib/(.*)$",
		"^@/hooks/(.*)$",
		"^@/components/ui/(.*)$",
		"^@/components/(.*)$",
		"^@/styles/(.*)$",
		"",
		"^[./]"
	],
	"importOrderParserPlugins": ["typescript", "jsx", "decorators-legacy"],
	"plugins": [
		"@ianvs/prettier-plugin-sort-imports",
		"prettier-plugin-tailwindcss"
	],
	"tailwindFunctions": ["cn", "cva"]
}
