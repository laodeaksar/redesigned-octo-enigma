# =============================================================================
# apps/checkout — environment variables
# Copy to .env and fill in values.
# =============================================================================

# Server
PORT=3004
NODE_ENV=development

# JWT — must match JWT_SECRET used by auth-service and api-gateway
JWT_SECRET=your-jwt-secret-here

# API Gateway — all checkout proxies go through here
API_GATEWAY_URL=http://localhost:3000

# CORS — comma-separated allowed origins (use * for development only)
CORS_ORIGINS=http://localhost:5000

# Redis — optional; caching disabled gracefully when unavailable
# REDIS_URL=redis://localhost:6379
