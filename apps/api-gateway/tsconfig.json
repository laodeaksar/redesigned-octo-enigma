{
  "extends": "@repo/tsconfig/bundler",
  "compilerOptions": {
    "rootDir": "./src",
    "paths": {
      "@/*": ["./src/*"],
      "@/config": ["./src/config.ts"],
      "@/lib": ["./src/lib/*"]
    },
    "strictNullChecks": true,
    "types": ["bun", "node"]
  },
  "include": ["src", "vitest.config.ts"],
  "exclude": ["node_modules", "dist"]
}
