---
const currentPath = Astro.url.pathname;

const isHome = currentPath === "/";
const isProducts = currentPath.startsWith("/products");
const isWishlist = currentPath.startsWith("/wishlist");
const isCart = currentPath.startsWith("/cart");
---

<!-- ── Search sheet overlay ─────────────────────────────────────────────── -->
<div
  id="search-backdrop"
  class="fixed inset-0 z-[60] bg-black/40 opacity-0 pointer-events-none transition-opacity duration-300 md:hidden"
  aria-hidden="true"
></div>

<div
  id="search-sheet"
  class="fixed bottom-0 left-0 right-0 z-[70] flex flex-col rounded-t-2xl bg-white shadow-2xl translate-y-full transition-transform duration-300 ease-out md:hidden"
  role="dialog"
  aria-modal="true"
  aria-label="Cari produk"
  style="max-height: 80dvh;"
>
  <!-- Drag handle -->
  <div class="flex justify-center pt-3 pb-1">
    <div class="h-1 w-10 rounded-full bg-gray-200"></div>
  </div>

  <!-- Header -->
  <div class="flex items-center gap-3 px-4 pb-3 pt-1">
    <svg
      class="h-5 w-5 shrink-0 text-gray-400"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      stroke-width="2"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"
      />
    </svg>
    <input
      id="search-input"
      type="search"
      autocomplete="off"
      autocorrect="off"
      spellcheck="false"
      placeholder="Cari produk…"
      class="flex-1 bg-transparent text-base text-gray-900 placeholder-gray-400 outline-none"
    >
    <button
      id="search-close"
      class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-gray-400 hover:bg-gray-100 hover:text-gray-600"
      aria-label="Tutup pencarian"
    >
      <svg
        class="h-5 w-5"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M6 18L18 6M6 6l12 12"
        />
      </svg>
    </button>
  </div>

  <div class="mx-4 mb-3 h-px bg-gray-100"></div>

  <!-- Recent searches -->
  <div id="search-recents" class="flex-1 overflow-y-auto px-4 pb-6">
    <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-gray-400">
      Pencarian Terbaru
    </p>
    <ul id="search-recents-list" class="space-y-0.5"></ul>
    <p id="search-recents-empty" class="hidden text-sm text-gray-400">
      Belum ada pencarian terbaru.
    </p>
  </div>
</div>

<!-- ── Bottom navigation bar ─────────────────────────────────────────────── -->
<nav
  class="fixed bottom-0 left-0 right-0 z-50 border-t border-gray-100 bg-white/95 backdrop-blur-sm md:hidden"
  aria-label="Mobile navigation"
>
  <div class="flex h-16 items-center justify-around px-1">
    <!-- Home -->
    <a
      href="/"
      class:list={[
        "flex flex-col items-center gap-0.5 min-w-0 flex-1 px-1 py-1 rounded-lg transition-colors",
        isHome ? "text-brand-500" : "text-gray-500 hover:text-gray-700",
      ]}
      aria-label="Beranda"
    >
      <svg
        class="h-6 w-6"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"
        />
      </svg>
      <span class="text-[10px] font-medium leading-none">Beranda</span>
    </a>

    <!-- Products -->
    <a
      href="/products"
      class:list={[
        "flex flex-col items-center gap-0.5 min-w-0 flex-1 px-1 py-1 rounded-lg transition-colors",
        isProducts ? "text-brand-500" : "text-gray-500 hover:text-gray-700",
      ]}
      aria-label="Produk"
    >
      <svg
        class="h-6 w-6"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"
        />
      </svg>
      <span class="text-[10px] font-medium leading-none">Produk</span>
    </a>

    <!-- Search (center pill) -->
    <button
      id="search-open"
      class="flex flex-col items-center gap-0.5 min-w-0 flex-1 px-1 py-1 rounded-lg transition-colors text-gray-500 hover:text-brand-500"
      aria-label="Cari produk"
      aria-haspopup="dialog"
    >
      <span
        class="flex h-10 w-10 items-center justify-center rounded-full bg-brand-500 text-white shadow-md -mt-5"
      >
        <svg
          class="h-5 w-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2.5"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"
          />
        </svg>
      </span>
      <span class="text-[10px] font-medium leading-none">Cari</span>
    </button>

    <!-- Wishlist -->
    <a
      href="/wishlist"
      class:list={[
        "relative flex flex-col items-center gap-0.5 min-w-0 flex-1 px-1 py-1 rounded-lg transition-colors",
        isWishlist ? "text-rose-500" : "text-gray-500 hover:text-rose-400",
      ]}
      aria-label="Wishlist"
    >
      <span class="relative">
        <svg
          class="h-6 w-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z"
          />
        </svg>
        <span
          id="mobile-wishlist-count"
          class="hidden absolute -right-2 -top-1.5 h-4 min-w-4 items-center justify-center rounded-full bg-rose-500 px-0.5 text-[9px] font-bold text-white"
          >0</span
        >
      </span>
      <span class="text-[10px] font-medium leading-none">Wishlist</span>
    </a>

    <!-- Cart -->
    <button
      id="mobile-cart-toggle"
      class:list={[
        "relative flex flex-col items-center gap-0.5 min-w-0 flex-1 px-1 py-1 rounded-lg transition-colors",
        isCart ? "text-accent" : "text-gray-500 hover:text-gray-700",
      ]}
      aria-label="Keranjang"
    >
      <span class="relative">
        <svg
          class="h-6 w-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"
          />
        </svg>
        <span
          id="mobile-cart-count"
          class="hidden absolute -right-2 -top-1.5 h-4 min-w-4 items-center justify-center rounded-full bg-accent px-0.5 text-[9px] font-bold text-white"
          >0</span
        >
      </span>
      <span class="text-[10px] font-medium leading-none">Keranjang</span>
    </button>
  </div>
</nav>

<script>
  import { $cartCount, $isCartOpen } from "@/stores/cart.store";
  import { $wishlistCount } from "@/stores/wishlist.store";

  // ── Badge subscriptions ──────────────────────────────────────────────────────

  $cartCount.subscribe((count) => {
    const el = document.getElementById("mobile-cart-count");
    if (!el) {
      return;
    }
    el.textContent = String(count > 99 ? "99+" : count);
    el.classList.toggle("hidden", count === 0);
    el.classList.toggle("flex", count > 0);
  });

  $wishlistCount.subscribe((count) => {
    const el = document.getElementById("mobile-wishlist-count");
    if (!el) {
      return;
    }
    el.textContent = String(count > 99 ? "99+" : count);
    el.classList.toggle("hidden", count === 0);
    el.classList.toggle("flex", count > 0);
  });

  document
    .getElementById("mobile-cart-toggle")
    ?.addEventListener("click", () => {
      $isCartOpen.set(!$isCartOpen.get());
    });

  // ── Search sheet ─────────────────────────────────────────────────────────────

  const STORAGE_KEY = "recentSearches";
  const MAX_RECENTS = 6;

  const sheet = document.getElementById("search-sheet")!;
  const backdrop = document.getElementById("search-backdrop")!;
  const input = document.getElementById("search-input") as HTMLInputElement;
  const closeBtn = document.getElementById("search-close")!;
  const openBtn = document.getElementById("search-open")!;
  const recentsList = document.getElementById("search-recents-list")!;
  const recentsEmpty = document.getElementById("search-recents-empty")!;

  function getRecents(): string[] {
    try {
      return JSON.parse(localStorage.getItem(STORAGE_KEY) ?? "[]") as string[];
    } catch {
      return [];
    }
  }

  function saveRecent(query: string) {
    const trimmed = query.trim();
    if (!trimmed) {
      return;
    }
    const recents = [
      trimmed,
      ...getRecents().filter((r) => r !== trimmed),
    ].slice(0, MAX_RECENTS);
    localStorage.setItem(STORAGE_KEY, JSON.stringify(recents));
  }

  function removeRecent(query: string) {
    const recents = getRecents().filter((r) => r !== query);
    localStorage.setItem(STORAGE_KEY, JSON.stringify(recents));
    renderRecents();
  }

  function renderRecents() {
    const recents = getRecents();
    recentsList.innerHTML = "";

    if (recents.length === 0) {
      recentsEmpty.classList.remove("hidden");
      return;
    }

    recentsEmpty.classList.add("hidden");

    recents.forEach((term) => {
      const li = document.createElement("li");
      li.className =
        "flex items-center gap-2 group rounded-lg px-2 py-2 hover:bg-gray-50 cursor-pointer";
      li.innerHTML = `
          <svg class="h-4 w-4 shrink-0 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <span class="flex-1 text-sm text-gray-700">${term.replace(/</g, "&lt;")}</span>
          <button class="hidden group-hover:flex h-5 w-5 items-center justify-center rounded-full text-gray-300 hover:text-gray-500 delete-recent" data-term="${term.replace(/"/g, "&quot;")}">
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
            </svg>
          </button>
        `;

      li.addEventListener("click", (e) => {
        if ((e.target as HTMLElement).closest(".delete-recent")) {
          return;
        }
        navigate(term);
      });

      li.querySelector(".delete-recent")?.addEventListener("click", (e) => {
        e.stopPropagation();
        removeRecent(term);
      });

      recentsList.appendChild(li);
    });
  }

  function navigate(query: string) {
    const q = query.trim();
    if (!q) {
      return;
    }
    saveRecent(q);
    closeSheet();
    window.location.href = `/products?q=${encodeURIComponent(q)}`;
  }

  function openSheet() {
    renderRecents();
    sheet.classList.remove("translate-y-full");
    backdrop.classList.remove("opacity-0", "pointer-events-none");
    backdrop.classList.add("opacity-100");
    document.body.style.overflow = "hidden";
    // Slight delay so the transition runs before focus
    setTimeout(() => input.focus(), 50);
  }

  function closeSheet() {
    sheet.classList.add("translate-y-full");
    backdrop.classList.remove("opacity-100");
    backdrop.classList.add("opacity-0", "pointer-events-none");
    document.body.style.overflow = "";
    input.value = "";
  }

  openBtn.addEventListener("click", openSheet);
  closeBtn.addEventListener("click", closeSheet);
  backdrop.addEventListener("click", closeSheet);

  input.addEventListener("keydown", (e) => {
    if (e.key === "Enter") {
      navigate(input.value);
    }
    if (e.key === "Escape") {
      closeSheet();
    }
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      closeSheet();
    }
  });
</script>
