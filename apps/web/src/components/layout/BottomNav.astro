---
const currentPath = Astro.url.pathname;

const isHome = currentPath === "/";
const isProducts = currentPath.startsWith("/products");
const isWishlist = currentPath.startsWith("/wishlist");
const isCart = currentPath.startsWith("/cart");
---

<nav
  class="fixed bottom-0 left-0 right-0 z-50 border-t border-gray-100 bg-white/95 backdrop-blur-sm md:hidden"
  aria-label="Mobile navigation"
>
  <div class="flex h-16 items-center justify-around px-2">

    <!-- Home -->
    <a
      href="/"
      class:list={[
        "flex flex-col items-center gap-0.5 min-w-[3rem] px-2 py-1 rounded-lg transition-colors",
        isHome ? "text-brand-500" : "text-gray-500 hover:text-gray-700",
      ]}
      aria-label="Beranda"
    >
      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" xmlns="http://www.w3.org/2000/svg">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
      </svg>
      <span class="text-[10px] font-medium leading-none">Beranda</span>
    </a>

    <!-- Products -->
    <a
      href="/products"
      class:list={[
        "flex flex-col items-center gap-0.5 min-w-[3rem] px-2 py-1 rounded-lg transition-colors",
        isProducts ? "text-brand-500" : "text-gray-500 hover:text-gray-700",
      ]}
      aria-label="Produk"
    >
      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" xmlns="http://www.w3.org/2000/svg">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
      </svg>
      <span class="text-[10px] font-medium leading-none">Produk</span>
    </a>

    <!-- Wishlist -->
    <a
      href="/wishlist"
      class:list={[
        "relative flex flex-col items-center gap-0.5 min-w-[3rem] px-2 py-1 rounded-lg transition-colors",
        isWishlist ? "text-rose-500" : "text-gray-500 hover:text-rose-400",
      ]}
      aria-label="Wishlist"
    >
      <span class="relative">
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z" />
        </svg>
        <span
          id="mobile-wishlist-count"
          class="hidden absolute -right-2 -top-1.5 h-4 min-w-4 items-center justify-center rounded-full bg-rose-500 px-0.5 text-[9px] font-bold text-white"
        >0</span>
      </span>
      <span class="text-[10px] font-medium leading-none">Wishlist</span>
    </a>

    <!-- Cart -->
    <button
      id="mobile-cart-toggle"
      class:list={[
        "relative flex flex-col items-center gap-0.5 min-w-[3rem] px-2 py-1 rounded-lg transition-colors",
        isCart ? "text-accent" : "text-gray-500 hover:text-gray-700",
      ]}
      aria-label="Keranjang"
    >
      <span class="relative">
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
        </svg>
        <span
          id="mobile-cart-count"
          class="hidden absolute -right-2 -top-1.5 h-4 min-w-4 items-center justify-center rounded-full bg-accent px-0.5 text-[9px] font-bold text-white"
        >0</span>
      </span>
      <span class="text-[10px] font-medium leading-none">Keranjang</span>
    </button>

  </div>
</nav>

<script>
  import { $cartCount, $isCartOpen } from "@/stores/cart.store";
  import { $wishlistCount } from "@/stores/wishlist.store";

  $cartCount.subscribe((count) => {
    const el = document.getElementById("mobile-cart-count");
    if (!el) return;
    el.textContent = String(count > 99 ? "99+" : count);
    el.classList.toggle("hidden", count === 0);
    el.classList.toggle("flex", count > 0);
  });

  $wishlistCount.subscribe((count) => {
    const el = document.getElementById("mobile-wishlist-count");
    if (!el) return;
    el.textContent = String(count > 99 ? "99+" : count);
    el.classList.toggle("hidden", count === 0);
    el.classList.toggle("flex", count > 0);
  });

  document.getElementById("mobile-cart-toggle")?.addEventListener("click", () => {
    $isCartOpen.set(!$isCartOpen.get());
  });
</script>
