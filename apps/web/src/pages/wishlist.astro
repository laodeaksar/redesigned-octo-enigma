---
import BaseLayout from "@/components/layout/BaseLayout.astro";
import ProductCard from "@/components/shared/ProductCard.astro";
import Pagination from "@/components/shared/Pagination.astro";
import { getCurrentUser, getTokenFromCookies } from "@/lib/auth";
import { api, type WishlistItem } from "@/lib/api";

const user = await getCurrentUser(Astro.cookies);
if (!user) return Astro.redirect(`/auth/login?redirect=/wishlist`, 302);
const token = getTokenFromCookies(Astro.cookies)!;

const { searchParams } = Astro.url;
const page = parseInt(searchParams.get("page") ?? "1", 10);

let wishlists: WishlistItem[] = [];
let totalPages = 1;
let total = 0;

try {
  const res = await api.get<{
    success: true;
    data: { items: WishlistItem[] };
    meta: { total: number; page: number; limit: number; totalPages: number };
  }>("/wishlist", {
    token,
    params: { page, limit: 20 },
  });

  wishlists = res.data.items;
  total = res.meta.total;
  totalPages = res.meta.totalPages;
} catch {
  // show empty state
}
---

<BaseLayout title="Wishlist Saya">
  <main class="max-w-7xl mx-auto px-4 py-8">
    <h1 class="text-2xl font-bold mb-6">
      Wishlist Saya
      {total > 0 && (
        <span class="ml-2 text-base font-normal text-gray-500">
          ({total} produk)
        </span>
      )}
    </h1>

    {wishlists.length === 0 ? (
      <div class="text-center py-24 text-gray-400">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="mx-auto w-16 h-16 mb-4 opacity-30"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="1.5"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935
               0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733
               -4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22
               9 12 9 12s9-4.78 9-12Z"
          />
        </svg>
        <p class="text-lg font-medium">Wishlist masih kosong</p>
        <p class="mt-1 text-sm">Simpan produk favorit kamu di sini</p>
        <a
          href="/products"
          class="mt-6 inline-block px-5 py-2 bg-primary text-white rounded-lg text-sm font-medium hover:bg-primary/90"
        >
          Jelajahi Produk
        </a>
      </div>
    ) : (
      <>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4">
          {wishlists.map(({ product }) => (
            <ProductCard
              id={product.id}
              name={product.name}
              slug={product.slug}
              primaryImage={product.primaryImage}
              lowestPrice={product.lowestPrice}
              highestPrice={product.highestPrice}
              totalStock={product.totalStock}
              tags={product.tags}
            />
          ))}
        </div>

        <Pagination page={page} totalPages={totalPages} baseUrl="/wishlist" />
      </>
    )}
  </main>
</BaseLayout>
