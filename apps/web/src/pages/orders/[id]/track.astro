---
import BaseLayout from "@/components/layout/BaseLayout.astro";
import OrderTrackingTimeline from "@/components/islands/OrderTrackingTimeline";
import { requireAuth, getTokenFromCookies } from "@/lib/auth";
import { api, type OrderDetail } from "@/lib/api";

const { id } = Astro.params;
await requireAuth(Astro, `/auth/login?redirect=/orders/${id}/track`);
const token = getTokenFromCookies(Astro.cookies)!;

let order: OrderDetail | null = null;

try {
  const res = await api.get<{ success: true; data: OrderDetail }>(`/orders/${id}`, { token });
  order = res.data;
} catch {
  return Astro.redirect("/orders");
}

if (!order) return Astro.redirect("/orders");
---

<BaseLayout title={`Lacak Pesanan ${order.orderNumber}`}>
  <div class="container mx-auto max-w-2xl px-4 py-8">

    <!-- Header -->
    <div class="mb-6 flex items-center justify-between gap-4">
      <div>
        <a
          href={`/orders/${id}`}
          class="mb-1 inline-flex items-center gap-1 text-sm text-gray-400 hover:text-gray-700 transition-colors"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
          </svg>
          Detail Pesanan
        </a>
        <h1 class="text-xl font-bold text-gray-900">Lacak Pesanan</h1>
      </div>

      <!-- Share / copy link button -->
      <button
        id="copy-link-btn"
        class="inline-flex items-center gap-2 rounded-xl border border-gray-200 bg-white px-4 py-2 text-sm font-medium text-gray-600 shadow-sm transition hover:border-green-300 hover:text-green-700"
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
        </svg>
        Bagikan
      </button>
    </div>

    <!-- Live tracking timeline island -->
    <OrderTrackingTimeline
      client:load
      orderId={order.id}
      orderNumber={order.orderNumber}
      initialStatus={order.status}
      initialStatusHistory={(order as any).statusHistory ?? []}
      cancellationReason={(order as any).cancellationReason ?? null}
      cancellationNote={(order as any).cancellationNote ?? null}
      shipping={order.shipping}
      grandTotal={order.pricing.grandTotal}
      itemCount={order.items.length}
    />

    <!-- Footer link to full order details -->
    <div class="mt-6 text-center">
      <a
        href={`/orders/${id}`}
        class="inline-flex items-center gap-2 text-sm font-medium text-green-700 hover:underline"
      >
        Lihat Detail Lengkap Pesanan
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </div>
</BaseLayout>

<script>
  const btn = document.getElementById("copy-link-btn");
  btn?.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(window.location.href);
      btn.textContent = "✓ Link disalin!";
      btn.classList.add("text-green-700", "border-green-300");
      setTimeout(() => {
        btn.innerHTML = `
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
          </svg>
          Bagikan
        `;
        btn.classList.remove("text-green-700", "border-green-300");
      }, 2000);
    } catch {
      // Clipboard not available
    }
  });
</script>
