---
import SearchBar from "@/components/islands/SearchBar";

interface Props {
  user?: { name: string } | null;
}
const { user } = Astro.props;
const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-40 border-b border-gray-100 bg-white/95 backdrop-blur-sm">
  <nav class="container mx-auto flex h-16 items-center gap-3 px-4">

    <!-- Brand -->
    <a href="/" class="flex shrink-0 items-center gap-2 text-lg font-bold text-brand-500">
      <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-brand-500 text-white text-sm">🛒</span>
      <span class="hidden sm:block">My Ecommerce</span>
    </a>

    <!-- Search bar (desktop: grows, mobile: hidden — toggled separately) -->
    <div class="hidden flex-1 md:flex md:justify-center">
      <SearchBar client:load />
    </div>

    <!-- Nav links + actions (desktop) -->
    <div class="ml-auto flex shrink-0 items-center gap-4">
      <!-- Produk link -->
      <a
        href="/products"
        class:list={[
          "hidden text-sm font-medium transition-colors hover:text-accent md:block",
          currentPath.startsWith("/products") ? "text-accent" : "text-gray-600",
        ]}
      >
        Produk
      </a>

      <!-- Wishlist -->
      <a
        href="/wishlist"
        class:list={[
          "relative hidden items-center gap-1 text-sm font-medium transition-colors hover:text-rose-500 md:flex",
          currentPath.startsWith("/wishlist") ? "text-rose-500" : "text-gray-600",
        ]}
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round"
            d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z" />
        </svg>
        Wishlist
        <span id="wishlist-count" class="hidden absolute -right-3.5 -top-2 h-4 w-4 items-center justify-center rounded-full bg-rose-500 text-[10px] font-bold text-white">0</span>
      </a>

      <!-- Mobile search toggle -->
      <button
        id="mobile-search-toggle"
        class="flex h-9 w-9 items-center justify-center rounded-md text-gray-600 transition-colors hover:bg-gray-100 md:hidden"
        aria-label="Buka pencarian"
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z" />
        </svg>
      </button>

      <!-- Cart button -->
      <button
        id="cart-toggle"
        class="relative flex h-9 w-9 items-center justify-center rounded-md text-gray-600 transition-colors hover:bg-gray-100 hover:text-gray-900"
        aria-label="Buka keranjang"
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
        </svg>
        <span id="cart-count" class="absolute -right-0.5 -top-0.5 hidden h-4 w-4 items-center justify-center rounded-full bg-accent text-[10px] font-bold text-white">0</span>
      </button>

      <!-- User menu / Login -->
      {user ? (
        <div class="relative group">
          <button class="flex h-9 items-center gap-2 rounded-md px-3 text-sm font-medium text-gray-700 hover:bg-gray-100">
            <div class="flex h-6 w-6 items-center justify-center rounded-full bg-brand-500/10 text-xs font-semibold text-brand-500">
              {user.name.charAt(0).toUpperCase()}
            </div>
            <span class="hidden sm:block">{user.name.split(" ")[0]}</span>
          </button>
          <div class="absolute right-0 top-full mt-1 hidden w-44 rounded-lg border border-gray-100 bg-white py-1 shadow-lg group-hover:block">
            <a href="/orders" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50">Pesanan Saya</a>
            <a href="/wishlist" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50">Wishlist Saya</a>
            <a href="/profile" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50">Profil</a>
            <hr class="my-1 border-gray-100" />
            <form action="/api/auth/logout" method="post">
              <button type="submit" class="block w-full px-4 py-2 text-left text-sm text-red-600 hover:bg-gray-50">Keluar</button>
            </form>
          </div>
        </div>
      ) : (
        <a href="/auth/login" class="rounded-md bg-brand-500 px-4 py-2 text-sm font-semibold text-white transition-opacity hover:opacity-90">
          Masuk
        </a>
      )}
    </div>
  </nav>

  <!-- Mobile search bar (expandable row) -->
  <div id="mobile-search-bar" class="hidden border-t border-gray-100 px-4 py-2 md:hidden">
    <SearchBar client:load />
  </div>
</header>

<script>
  import { $cartCount, $isCartOpen } from "@/stores/cart.store";
  import { $wishlistCount } from "@/stores/wishlist.store";

  $cartCount.subscribe((count) => {
    const el = document.getElementById("cart-count");
    if (!el) return;
    el.textContent = String(count);
    el.classList.toggle("hidden", count === 0);
    el.classList.toggle("flex", count > 0);
  });

  $wishlistCount.subscribe((count) => {
    const el = document.getElementById("wishlist-count");
    if (!el) return;
    el.textContent = String(count);
    el.classList.toggle("hidden", count === 0);
    el.classList.toggle("flex", count > 0);
  });

  document.getElementById("cart-toggle")?.addEventListener("click", () => {
    $isCartOpen.set(!$isCartOpen.get());
  });

  document.getElementById("mobile-search-toggle")?.addEventListener("click", () => {
    const bar = document.getElementById("mobile-search-bar");
    if (!bar) return;
    bar.classList.toggle("hidden");
    if (!bar.classList.contains("hidden")) {
      bar.querySelector("input")?.focus();
    }
  });
</script>
