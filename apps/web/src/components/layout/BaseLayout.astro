---
import CartDrawer from "@/components/islands/CartDrawer";
import CompareBar from "@/components/islands/CompareBar";
import ProductQuickView from "@/components/islands/ProductQuickView";
import { UndoToast } from "@/components/islands/UndoToast";
import ScrollToTop from "@/components/shared/ScrollToTop.astro";
import { getCurrentUser } from "@/lib/auth";
import BottomNav from "./BottomNav.astro";
import Footer from "./Footer.astro";
import Navbar from "./Navbar.astro";
import "@/styles/global.css";

interface Props {
  description?: string;
  title?: string;
}

const {
  title = "My Ecommerce",
  description = "Belanja produk terbaik dengan harga terjangkau",
} = Astro.props;

// Get user from cookie (SSR)
const user = await getCurrentUser(Astro.cookies);
---

<!doctype html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content={description}>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <title>{title} — My Ecommerce</title>
    <!-- Inter font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    >
    <slot name="head" />
  </head>
  <body class="min-h-screen bg-white text-gray-900 antialiased">
    <!-- Always-mounted React islands -->
    <CartDrawer client:load isLoggedIn={!!user} />
    <ProductQuickView client:idle />
    <UndoToast client:idle />
    <CompareBar client:idle />

    <Navbar user={user} />

    <main class="pb-16 md:pb-0">
      <slot />
    </main>

    <Footer />

    <ScrollToTop />
    <BottomNav />

    <!-- Hydrate cart from localStorage on mount -->
    <script>
      import { hydrateCart } from "@/stores/cart.store";

      hydrateCart();
    </script>

    <!-- Prefetch /checkout as soon as the cart has items.
         Two triggers:
           1. Page load  — check localStorage directly (catches returning users
              and multi-page sessions before $cart is hydrated)
           2. First add-to-cart this session — subscribe to $cart atom,
              inject once when the count transitions 0 → ≥1, then unsub.
         prefetchCheckout() is idempotent — duplicate calls are no-ops. -->
    <script>
      import { $cart } from "@/stores/cart.store";

      function prefetchCheckout() {
        // Already on the checkout page — nothing to prefetch
        if (window.location.pathname === "/checkout") return;
        // Link already injected this session
        if (document.querySelector('link[rel="prefetch"][href="/checkout"]')) return;

        const link = document.createElement("link");
        link.rel = "prefetch";
        link.href = "/checkout";
        link.as = "document";
        document.head.appendChild(link);
      }

      // Trigger 1: check localStorage before $cart is hydrated
      try {
        const raw = localStorage.getItem("cart");
        if (raw) {
          const stored = JSON.parse(raw) as Array<unknown>;
          if (Array.isArray(stored) && stored.length > 0) {
            prefetchCheckout();
          }
        }
      } catch {
        // Corrupt storage — skip
      }

      // Trigger 2: watch for the first add-to-cart this session
      const unsub = $cart.subscribe(items => {
        if (items.length > 0) {
          prefetchCheckout();
          unsub(); // fire once — no need to keep watching
        }
      });
    </script>

    <!-- Hydrate wishlist when user is logged in -->
    {user && (
      <script>
        import { hydrateWishlist } from "@/stores/wishlist.store";
        hydrateWishlist();
      </script>
    )}
  </body>
</html>
