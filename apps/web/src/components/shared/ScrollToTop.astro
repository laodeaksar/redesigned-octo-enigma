---
// ScrollToTop — appears after scrolling past one viewport height.
// Positioned above the mobile bottom nav on small screens.
---

<button
  id="scroll-to-top"
  aria-label="Kembali ke atas"
  class="
    fixed right-4 z-40
    bottom-[5.5rem] md:bottom-8
    flex h-10 w-10 items-center justify-center
    rounded-full bg-white shadow-lg ring-1 ring-gray-100
    text-gray-500 hover:bg-brand-500 hover:text-white hover:ring-brand-500
    opacity-0 scale-75 pointer-events-none
    transition-all duration-200
  "
>
  <svg
    class="h-5 w-5"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    stroke-width="2.5"
    xmlns="http://www.w3.org/2000/svg"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M4.5 10.5 12 3m0 0 7.5 7.5M12 3v18"
    />
  </svg>
</button>

<script>
  const btn = document.getElementById("scroll-to-top");
  if (btn) {
    const THRESHOLD = window.innerHeight * 0.9;

    function sync() {
      const visible = window.scrollY > THRESHOLD;
      btn.classList.toggle("opacity-0", !visible);
      btn.classList.toggle("scale-75", !visible);
      btn.classList.toggle("pointer-events-none", !visible);
      btn.classList.toggle("opacity-100", visible);
      btn.classList.toggle("scale-100", visible);
    }

    window.addEventListener("scroll", sync, { passive: true });
    sync();

    btn.addEventListener("click", () => {
      window.scrollTo({ top: 0, behavior: "smooth" });
    });
  }
</script>
