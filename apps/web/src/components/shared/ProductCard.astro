---
import Badge from "./Badge.astro";
import CompareToggle from "@/components/islands/CompareToggle";
import { formatIDR } from "@/lib/utils";

interface Props {
  id: string;
  name: string;
  slug: string;
  primaryImage: string | null;
  lowestPrice: number;
  highestPrice: number;
  totalStock: number;
  tags?: string[];
  categoryName?: string | null;
}

const { id, name, slug, primaryImage, lowestPrice, highestPrice, totalStock, tags, categoryName } = Astro.props;

const isOutOfStock = totalStock === 0;
const hasDiscount  = lowestPrice !== highestPrice;
const priceLabel   = hasDiscount
  ? `${formatIDR(lowestPrice)} – ${formatIDR(highestPrice)}`
  : formatIDR(lowestPrice);
---

<article
  class:list={[
    "group flex flex-col overflow-hidden rounded-xl border border-gray-100 bg-white shadow-sm transition-all hover:-translate-y-0.5 hover:shadow-md",
    isOutOfStock && "opacity-70",
  ]}
>
  <!-- Image + Quick View overlay -->
  <div class="relative aspect-square overflow-hidden bg-gray-50">
    <a href={`/products/${slug}`} tabindex="-1" aria-hidden="true" class="block h-full w-full">
      {primaryImage ? (
        <img
          src={primaryImage}
          alt={name}
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
          loading="lazy"
        />
      ) : (
        <div class="flex h-full w-full items-center justify-center text-4xl text-gray-200">
          📦
        </div>
      )}
    </a>

    <!-- Quick View button — always visible on mobile, hover-only on desktop -->
    <button
      data-quick-view={slug}
      aria-label={`Lihat cepat ${name}`}
      class="
        absolute bottom-0 left-0 right-0
        flex items-center justify-center gap-1.5
        bg-white/90 backdrop-blur-sm
        py-2 text-xs font-semibold text-gray-700
        opacity-100 md:opacity-0 md:group-hover:opacity-100
        translate-y-0 md:translate-y-1 md:group-hover:translate-y-0
        transition-all duration-200
        hover:bg-white hover:text-brand-500
      "
    >
      <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" xmlns="http://www.w3.org/2000/svg">
        <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.641 0-8.573-3.007-9.964-7.178z" />
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
      </svg>
      Lihat Cepat
    </button>
  </div>

  <!-- Info -->
  <div class="flex flex-1 flex-col p-4">
    <a href={`/products/${slug}`} class="flex flex-1 flex-col">
      <p class="line-clamp-2 text-sm font-medium text-gray-900 leading-snug">{name}</p>

      <div class="mt-2 flex items-center gap-2">
        <span class="text-base font-bold text-gray-900">{priceLabel}</span>
      </div>

      <div class="mt-2 flex flex-wrap items-center gap-1.5">
        {isOutOfStock && <Badge variant="destructive">Habis</Badge>}
        {!isOutOfStock && totalStock <= 5 && <Badge variant="warning">Sisa {totalStock}</Badge>}
        {tags?.slice(0, 2).map((tag) => (
          <Badge variant="secondary">{tag}</Badge>
        ))}
      </div>
    </a>

    <!-- Compare toggle — outside <a> to avoid nested interactive elements -->
    <div class="mt-3 border-t border-gray-50 pt-2.5">
      <CompareToggle
        client:visible
        product={{
          id,
          name,
          slug,
          primaryImage,
          lowestPrice,
          highestPrice,
          totalStock,
          tags: tags ?? [],
          categoryName: categoryName ?? null,
        }}
      />
    </div>
  </div>
</article>

<script>
  // Event delegation — runs once, handles all quick-view buttons on the page.
  if (!(window as unknown as Record<string, boolean>).__quickViewInit) {
    (window as unknown as Record<string, boolean>).__quickViewInit = true;
    document.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest("[data-quick-view]");
      if (!btn) return;
      e.preventDefault();
      e.stopPropagation();
      const slug = (btn as HTMLElement).dataset.quickView;
      if (slug) {
        window.dispatchEvent(
          new CustomEvent("open-quick-view", { detail: { slug } })
        );
      }
    });
  }
</script>
