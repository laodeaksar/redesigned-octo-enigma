---
import ForgotPasswordForm from "@/components/islands/ForgotPasswordForm";
import BaseLayout from "@/components/layout/BaseLayout.astro";
---

<BaseLayout title="Lupa Password">
  <div
    class="flex min-h-[calc(100vh-8rem)] items-center justify-center px-4 py-12"
  >
    <div class="w-full max-w-sm">
      <div class="mb-8 text-center">
        <h1 class="text-2xl font-bold text-gray-900">Lupa Password?</h1>
        <p class="mt-1 text-sm text-gray-500">
          Masukkan email kamu dan kami akan kirimkan link untuk reset password.
        </p>
      </div>
      <div
        class="rounded-2xl border border-gray-100 bg-white p-8 shadow-sm"
      >
        <ForgotPasswordForm client:load />
      </div>
    </div>
  </div>
</BaseLayout>
