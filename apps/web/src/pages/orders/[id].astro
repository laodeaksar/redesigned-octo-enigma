---
import BaseLayout from "@/components/layout/BaseLayout.astro";
import Card from "@/components/shared/Card.astro";
import ReorderButton from "@/components/islands/ReorderButton";
import OrderStatusTracker from "@/components/islands/OrderStatusTracker";
import PushNotificationManager from "@/components/islands/PushNotificationManager";
import { requireAuth, getTokenFromCookies } from "@/lib/auth";
import { api, type OrderDetail, type Payment } from "@/lib/api";
import { formatIDR, formatDateTime } from "@/lib/utils";

const { id } = Astro.params;
await requireAuth(Astro, `/auth/login?redirect=/orders/${id}`);
const token = getTokenFromCookies(Astro.cookies)!;

let order: OrderDetail | null = null;
let payment: Payment | null = null;

try {
  const [orderRes, paymentRes] = await Promise.allSettled([
    api.get<{ success: true; data: OrderDetail }>(`/orders/${id}`, { token }),
    api.get<{ success: true; data: Payment }>(`/payments/order/${id}`, {
      token,
    }),
  ]);
  if (orderRes.status === "fulfilled") order = orderRes.value.data;
  if (paymentRes.status === "fulfilled") payment = paymentRes.value.data;
} catch {
  return Astro.redirect("/orders");
}

if (!order) return Astro.redirect("/orders");

const qsStatus = Astro.url.searchParams.get("status"); // "success" | "pending" from Midtrans redirect
const showPayButton =
  payment?.status === "pending" &&
  payment?.snapToken &&
  order.status === "pending_payment";

const PAYMENT_STATUS_LABELS: Record<string, string> = {
  pending: "Menunggu",
  paid: "Lunas",
  failed: "Gagal",
  refunded: "Direfund",
  expired: "Kedaluwarsa",
};
const PAYMENT_STATUS_COLORS: Record<string, string> = {
  pending: "bg-yellow-100 text-yellow-800",
  paid: "bg-green-100 text-green-800",
  failed: "bg-red-100 text-red-800",
  refunded: "bg-gray-100 text-gray-600",
  expired: "bg-red-100 text-red-800",
};
---

<BaseLayout title={`Pesanan ${order.orderNumber}`}>
  <!-- Midtrans Snap.js — only loaded if we need the pay button -->
  {showPayButton && (
    <script
      slot="head"
      src="https://app.sandbox.midtrans.com/snap/snap.js"
      data-client-key={import.meta.env.PUBLIC_MIDTRANS_CLIENT_KEY ?? ""}
    />
  )}

  <div class="container mx-auto max-w-5xl px-4 py-8">
    <!-- Payment result banners -->
    {qsStatus === "success" && (
      <div class="mb-6 flex items-start gap-3 rounded-xl border border-green-100 bg-green-50 px-5 py-4 text-green-800">
        <span class="text-2xl">🎉</span>
        <div>
          <p class="font-semibold">Pembayaran berhasil!</p>
          <p class="text-sm">Pesananmu sedang diproses. Kami akan mengirimkan update via email.</p>
        </div>
      </div>
    )}
    {qsStatus === "pending" && (
      <div class="mb-6 flex items-start gap-3 rounded-xl border border-yellow-100 bg-yellow-50 px-5 py-4 text-yellow-800">
        <span class="text-2xl">⏳</span>
        <div>
          <p class="font-semibold">Menunggu pembayaran</p>
          <p class="text-sm">
            Selesaikan pembayaran sebelum {order.expiresAt ? formatDateTime(order.expiresAt) : "—"}.
          </p>
        </div>
      </div>
    )}

    <!-- Header -->
    <div class="mb-4 flex flex-wrap items-start justify-between gap-4">
      <div>
        <a
          href="/orders"
          class="mb-2 inline-flex items-center gap-1 text-sm text-gray-400 hover:text-gray-700 transition-colors"
        >
          <svg
            class="h-4 w-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M15 19l-7-7 7-7"
            />
          </svg>
          Pesanan Saya
        </a>
        <h1 class="font-mono text-xl font-bold text-gray-900">
          {order.orderNumber}
        </h1>
        <p class="mt-0.5 text-sm text-gray-500">
          Dipesan {formatDateTime(order.createdAt)}
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-3">
        <PushNotificationManager
          client:load
          orderId={order.id}
          orderNumber={order.orderNumber}
        />
        {["processing", "shipped", "delivered"].includes(order.status) && (
          <a
            href={`/orders/${order.id}/track`}
            class="inline-flex items-center gap-2 rounded-xl border border-indigo-200 bg-indigo-50 px-4 py-2 text-sm font-semibold text-indigo-700 shadow-sm transition hover:bg-indigo-100"
          >
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            Lacak Pesanan
          </a>
        )}
        <ReorderButton client:load items={order.items} />
      </div>
    </div>

    <!-- Live status tracker island: badge + timeline + cancelled banner -->
    <div class="mb-6">
      <OrderStatusTracker
        client:load
        orderId={order.id}
        initialStatus={order.status}
        initialStatusHistory={(order as any).statusHistory ?? []}
        cancellationReason={(order as any).cancellationReason ?? null}
        cancellationNote={(order as any).cancellationNote ?? null}
      />
    </div>

    <div class="grid gap-6 lg:grid-cols-3">
      <!-- ── Left col (2/3) ─────────────────────────────────────── -->
      <div class="space-y-6 lg:col-span-2">
        <!-- Order items -->
        <Card title="Item Pesanan">
          <div class="divide-y divide-gray-100">
            {order.items.map((item) => (
              <div class="flex items-center gap-4 py-4 first:pt-0 last:pb-0">
                <div class="h-16 w-16 shrink-0 overflow-hidden rounded-xl bg-gray-50">
                  {item.product.imageUrl
                    ? <img src={item.product.imageUrl} alt={item.product.name} class="h-full w-full object-cover" loading="lazy" />
                    : <div class="flex h-full w-full items-center justify-center text-3xl">📦</div>
                  }
                </div>
                <div class="flex-1 min-w-0">
                  <p class="truncate text-sm font-medium text-gray-900">{item.product.name}</p>
                  <p class="text-xs text-gray-500">{item.product.variantName}</p>
                  <p class="text-xs text-gray-400">SKU: {item.product.sku}</p>
                </div>
                <div class="shrink-0 text-right">
                  <p class="text-sm font-semibold text-gray-900">{formatIDR(item.subtotal)}</p>
                  <p class="text-xs text-gray-400">{formatIDR(item.unitPrice)} × {item.quantity}</p>
                </div>
              </div>
            ))}
          </div>

          <!-- Pricing summary -->
          <div class="mt-4 space-y-2 border-t border-gray-100 pt-4 text-sm">
            <div class="flex justify-between text-gray-600">
              <span>Subtotal</span>
              <span>{formatIDR(order.pricing.subtotal)}</span>
            </div>
            <div class="flex justify-between text-gray-600">
              <span>Ongkos kirim</span>
              <span>{formatIDR(order.pricing.shippingCost)}</span>
            </div>
            {order.pricing.discountTotal > 0 && (
              <div class="flex justify-between text-green-600">
                <span>Diskon</span>
                <span>- {formatIDR(order.pricing.discountTotal)}</span>
              </div>
            )}
            {order.discounts && order.discounts.map(d => (
              <div class="flex justify-between text-xs text-green-500 pl-3">
                <span>Kode: {d.code}</span>
                <span>- {formatIDR(d.amount)}</span>
              </div>
            ))}
            {order.pricing.taxTotal > 0 && (
              <div class="flex justify-between text-gray-600">
                <span>Pajak</span>
                <span>{formatIDR(order.pricing.taxTotal)}</span>
              </div>
            )}
            <div
              class="flex items-center justify-between border-t border-gray-100 pt-2 font-bold text-base"
            >
              <span>Total</span>
              <span class="text-green-700"
                >{formatIDR(order.pricing.grandTotal)}</span
              >
            </div>
          </div>
        </Card>

        <!-- Shipping info -->
        <Card title="Pengiriman">
          <div class="grid gap-6 sm:grid-cols-2 text-sm">
            <!-- Delivery address -->
            <div>
              <p
                class="mb-2 text-xs font-semibold uppercase tracking-wider text-gray-400"
              >
                Alamat Pengiriman
              </p>
              <p class="font-semibold text-gray-900">
                {order.shipping.address.recipientName}
              </p>
              <p class="text-gray-500">{order.shipping.address.phone}</p>
              <address class="mt-1 not-italic leading-relaxed text-gray-600">
                {order.shipping.address.street}<br>
                {order.shipping.address.city}, {order.shipping.address.province}
                {order.shipping.address.postalCode}
              </address>
            </div>

            <!-- Courier & tracking -->
            <div>
              <p
                class="mb-2 text-xs font-semibold uppercase tracking-wider text-gray-400"
              >
                Kurir
              </p>
              <p class="font-semibold text-gray-900">
                {order.shipping.courier.toUpperCase()}
                — {order.shipping.service}
              </p>
              {order.shipping.estimatedDays && (
                <p class="text-xs text-gray-500">Estimasi {order.shipping.estimatedDays} hari</p>
              )}

              {order.shipping.trackingNumber ? (
                <div class="mt-3 rounded-lg border border-indigo-100 bg-indigo-50 p-3">
                  <p class="text-xs font-semibold uppercase text-indigo-600">Nomor Resi</p>
                  <p class="mt-1 font-mono text-lg font-bold tracking-wider text-indigo-900">
                    {order.shipping.trackingNumber}
                  </p>
                  <a
                    href={`https://cekresi.com/?noresi=${order.shipping.trackingNumber}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="mt-2 inline-flex items-center gap-1 text-xs font-medium text-indigo-600 hover:underline"
                  >
                    Lacak Paket
                    <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                    </svg>
                  </a>
                </div>
              ) : (
                <p class="mt-3 text-xs text-gray-400 italic">
                  {order.status === "pending_payment" || order.status === "processing"
                    ? "Nomor resi belum tersedia"
                    : "Tidak ada nomor resi"}
                </p>
              )}

              {order.shipping.shippedAt && (
                <p class="mt-2 text-xs text-gray-500">
                  📤 Dikirim: {formatDateTime(order.shipping.shippedAt)}
                </p>
              )}
              {order.shipping.deliveredAt && (
                <p class="mt-1 text-xs text-gray-500">
                  📬 Diterima: {formatDateTime(order.shipping.deliveredAt)}
                </p>
              )}
            </div>
          </div>
        </Card>

        <!-- Customer note -->
        {order.customerNote && (
          <Card title="Catatan">
            <p class="text-sm text-gray-600 italic">"{order.customerNote}"</p>
          </Card>
        )}
      </div>

      <!-- ── Right col (1/3) ────────────────────────────────────── -->
      <div class="space-y-6">
        <!-- Payment card -->
        {payment ? (
          <Card title="Pembayaran">
            <div class="space-y-3 text-sm">

              <!-- Payment status -->
              <div class="flex items-center justify-between">
                <span class="text-gray-500">Status</span>
                <span class:list={[
                  "inline-flex rounded-full px-2.5 py-0.5 text-xs font-semibold",
                  PAYMENT_STATUS_COLORS[payment.status] ?? "bg-gray-100 text-gray-600"
                ]}>
                  {PAYMENT_STATUS_LABELS[payment.status] ?? payment.status}
                </span>
              </div>

              {payment.method && (
                <div class="flex items-center justify-between">
                  <span class="text-gray-500">Metode</span>
                  <span class="font-medium capitalize">{payment.method.replace(/_/g, " ")}</span>
                </div>
              )}

              <div class="flex items-center justify-between">
                <span class="text-gray-500">Total</span>
                <span class="font-semibold text-gray-900">{formatIDR(payment.amount)}</span>
              </div>

              <!-- Virtual Account -->
              {payment.virtualAccount && (
                <div class="mt-3 rounded-xl border border-blue-100 bg-blue-50 p-4">
                  <p class="text-xs font-semibold uppercase tracking-wider text-blue-600">
                    {payment.virtualAccount.bank} Virtual Account
                  </p>
                  <p class="mt-2 font-mono text-xl font-bold tracking-widest text-blue-900">
                    {payment.virtualAccount.vaNumber}
                  </p>
                  <p class="mt-1 text-xs text-blue-500">
                    Bayar sebelum {formatDateTime(payment.virtualAccount.expiresAt)}
                  </p>
                </div>
              )}

              <!-- E-wallet QR -->
              {payment.eWallet && (
                <div class="mt-3 rounded-xl border border-purple-100 bg-purple-50 p-4 text-center">
                  <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-purple-600">
                    {payment.eWallet.provider} QR Code
                  </p>
                  {payment.eWallet.qrCodeUrl
                    ? <img src={payment.eWallet.qrCodeUrl} alt="QR Code" class="mx-auto h-40 w-40 rounded-lg" />
                    : <p class="text-xs text-purple-400 italic">QR code tidak tersedia</p>
                  }
                  <p class="mt-2 text-xs text-purple-500">
                    Berlaku sampai {formatDateTime(payment.eWallet.expiresAt)}
                  </p>
                </div>
              )}

              <!-- Pay now button -->
              {showPayButton && (
                <button
                  id="pay-btn"
                  data-token={payment.snapToken}
                  data-order-id={order.id}
                  class="mt-3 flex w-full items-center justify-center gap-2 rounded-xl bg-green-600 py-3 text-sm font-bold text-white shadow-sm transition hover:bg-green-700 active:scale-95"
                >
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
                  </svg>
                  Bayar Sekarang
                </button>
              )}
            </div>
          </Card>
        ) : order.status === "pending_payment" ? (
          <Card title="Pembayaran">
            <p class="text-sm text-gray-500 italic">Informasi pembayaran tidak tersedia.</p>
          </Card>
        ) : null}

        <!-- Order summary (quick reference) -->
        <Card title="Ringkasan">
          <dl class="space-y-2 text-sm">
            <div class="flex justify-between">
              <dt class="text-gray-500">Nomor Pesanan</dt>
              <dd class="font-mono font-semibold text-gray-900">
                {order.orderNumber}
              </dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-gray-500">Jumlah Item</dt>
              <dd class="text-gray-700">{order.items.length} produk</dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-gray-500">Dipesan</dt>
              <dd class="text-gray-700">{formatDateTime(order.createdAt)}</dd>
            </div>
            {order.updatedAt && order.updatedAt !== order.createdAt && (
              <div class="flex justify-between">
                <dt class="text-gray-500">Diperbarui</dt>
                <dd class="text-gray-700">{formatDateTime(order.updatedAt)}</dd>
              </div>
            )}
          </dl>
        </Card>

        <!-- Help -->
        <div class="rounded-2xl bg-gray-50 p-5 text-sm">
          <p class="mb-1 font-semibold text-gray-900">Butuh Bantuan?</p>
          <p class="text-gray-500 leading-relaxed">
            Hubungi kami di{" "}
            <a
              href="mailto:support@my-ecommerce.com"
              class="text-green-700 hover:underline"
            >
              support@my-ecommerce.com
            </a>{" "}
            dan sertakan nomor pesananmu.
          </p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const btn = document.getElementById("pay-btn") as HTMLButtonElement | null;
  if (btn) {
    btn.addEventListener("click", () => {
      const token = btn.dataset.token;
      const orderId = btn.dataset.orderId;
      // @ts-ignore — Midtrans Snap global injected by snap.js
      window.snap?.pay(token, {
        onSuccess: () => {
          window.location.href = `/orders/${orderId}?status=success`;
        },
        onPending: () => {
          window.location.href = `/orders/${orderId}?status=pending`;
        },
        onError: () => {
          alert("Pembayaran gagal. Silakan coba lagi.");
        },
        onClose: () => {},
      });
    });
  }
</script>
