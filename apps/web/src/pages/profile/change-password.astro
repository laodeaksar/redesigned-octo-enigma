---
import ChangePasswordForm from "@/components/islands/ChangePasswordForm";
import BaseLayout from "@/components/layout/BaseLayout.astro";
import { api } from "@/lib/api";
import { getTokenFromCookies, requireAuth } from "@/lib/auth";

const user = await requireAuth(Astro, "/auth/login?redirect=/profile/change-password");
const token = getTokenFromCookies(Astro.cookies)!;

// Guard: OAuth-only accounts have no password to change — send them to set-password
try {
  const res = await api.get<{ success: true; data: { hasPassword: boolean } }>(
    "/users/me",
    { token }
  );
  if (!res.data.hasPassword) {
    return Astro.redirect("/profile/set-password");
  }
} catch {
  // If the fetch fails fall through and let the form handle the error gracefully
}
---

<BaseLayout title="Ubah Password">
  <div class="min-h-[calc(100vh-8rem)] bg-gray-50/50 py-8">
    <div class="mx-auto max-w-lg px-4">

      <nav class="mb-6 flex items-center gap-1.5 text-sm text-gray-500">
        <a href="/" class="hover:text-gray-700">Beranda</a>
        <span>/</span>
        <a href="/profile" class="hover:text-gray-700">Profil</a>
        <span>/</span>
        <span class="text-gray-900">Ubah Password</span>
      </nav>

      <div class="mb-6">
        <h1 class="text-2xl font-bold text-gray-900">Ubah Password</h1>
        <p class="mt-1 text-sm text-gray-500">
          Password baru harus minimal 8 karakter dengan huruf besar, kecil, dan angka.
        </p>
      </div>

      <div class="rounded-2xl border border-gray-100 bg-white p-8 shadow-sm">
        <ChangePasswordForm client:load />
      </div>

    </div>
  </div>
</BaseLayout>
