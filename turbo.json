{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "REDIS_URL",
    "MONGODB_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "package.json", "tsconfig.json"],
      "outputs": ["dist/**", ".next/**", ".astro/**"]
    },

    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },

    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tsconfig.json"],
      "outputs": []
    },

    "clean": {
      "cache": false
    },

    "db:generate": {
      "cache": false,
      "inputs": [
        "drizzle/schema/**",
        "drizzle.config.ts"
      ],
      "outputs": ["drizzle/migrations/**"]
    },

    "db:migrate": {
      "cache": false,
      "dependsOn": ["db:generate"]
    },

    "db:seed": {
      "cache": false,
      "dependsOn": ["db:migrate"]
    },

    "db:studio": {
      "cache": false,
      "persistent": true
    },

    "db:push": {
      "cache": false
    }
  }
}
