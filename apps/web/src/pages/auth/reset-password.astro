---
import ResetPasswordForm from "@/components/islands/ResetPasswordForm";
import BaseLayout from "@/components/layout/BaseLayout.astro";

const token = Astro.url.searchParams.get("token") ?? "";

if (!token) {
  return Astro.redirect("/auth/forgot-password");
}
---

<BaseLayout title="Reset Password">
  <div
    class="flex min-h-[calc(100vh-8rem)] items-center justify-center px-4 py-12"
  >
    <div class="w-full max-w-sm">
      <div class="mb-8 text-center">
        <h1 class="text-2xl font-bold text-gray-900">Buat Password Baru</h1>
        <p class="mt-1 text-sm text-gray-500">
          Password harus minimal 8 karakter dengan huruf besar, kecil, dan angka.
        </p>
      </div>
      <div
        class="rounded-2xl border border-gray-100 bg-white p-8 shadow-sm"
      >
        <ResetPasswordForm client:load token={token} />
      </div>
    </div>
  </div>
</BaseLayout>
